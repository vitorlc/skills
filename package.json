{
  "name": "@vitorlc/skills",
  "version": "1.0.1",
  "description": "Personal AI agent skills \u2014 install globally via npx",
  "type": "module",
  "bin": {
    "skills": "bin/skills.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts/skill_dir.sh",
    "skills/*/SKILL.md",
    "skills/*/scripts/**",
    "skills/*/references/**",
    "skills/*/workflows/**",
    "skills/*/styles.json",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/tests/**",
    "!**/node_modules/**",
    "!**/.cache/**"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "skills",
    "agent-skills",
    "claude",
    "opencode",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorlc/skills.git"
  },
  "devDependencies": {
    "semantic-release": "^25.0.8"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs skills/*/tests/*.test.mjs && python3 -B -m unittest discover -s skills/pluggy-investment-report/tests",
    "test:browser": "SKILLS_BROWSER_TESTS=1 node tests/browser.test.mjs"
  }
}
