{
  "name": "@vitorlc/skills",
  "version": "1.1.0",
  "description": "Personal AI agent skills — install globally via npx",
  "type": "module",
  "bin": {
    "skills": "bin/skills.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts/skill_dir.sh",
    "skills/*/SKILL.md",
    "skills/*/scripts/**",
    "skills/*/references/**",
    "skills/*/workflows/**",
    "skills/*/styles.json",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/tests/**"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "skills",
    "agent-skills",
    "claude",
    "opencode",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorlc/skills.git"
  }
}
